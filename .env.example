# Copie para .env (que NUNCA vai para o git) e preencha.
# Para gerar valores aleatórios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Infra (Docker) ---
POSTGRES_PASSWORD=gere-um-valor-aleatorio
SECRET_KEY_BASE=gere-um-valor-aleatorio-com-64-caracteres
# Chave da API do WAHA (WhatsApp). Também protege a integração com o Chatwoot.
WAHA_API_KEY=gere-um-valor-aleatorio
# Login do painel do WAHA (http://127.0.0.1:3002/dashboard), onde se lê o QR code.
WAHA_DASHBOARD_USERNAME=revgas
WAHA_DASHBOARD_PASSWORD=gere-um-valor-aleatorio

# --- Chatwoot ---
CHATWOOT_ACCOUNT_ID=1
# Token do SEU usuário admin (Chatwoot → Perfil → Token de acesso). Usado pelo npm run setup e pelo
# chatwoot-config. O setup também o grava na integração do WAHA (para criar contatos e mensagens):
# quem tiver a WAHA_API_KEY consegue lê-lo. Guarde as duas chaves com o mesmo cuidado.
CHATWOOT_ADMIN_TOKEN=
# Token do Agent Bot: o npm run setup imprime este valor.
CHATWOOT_BOT_TOKEN=
# Segredo no caminho do webhook do bot (32+ caracteres). Troque-o se aparecer em logs ou configurações expostas.
BOT_WEBHOOK_TOKEN=gere-um-valor-aleatorio

# --- IA (Gemini, cota grátis do Google AI Studio) ---
GEMINI_API_KEY=
# Modelo do Gemini (o Google aposenta modelos antigos; veja a lista em aistudio.google.com).
# Vários separados por vírgula = reservas: se o primeiro falhar (sobrecarga, cota), o bot tenta o próximo.
GEMINI_MODELO=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Opcional: reserva fora do Google. Some "openai:<modelo>" ao fim do GEMINI_MODELO (ex.: openai:gpt-5-mini).
OPENAI_API_KEY=
# Só estes números (com 55 + DDD, separados por vírgula) usam a IA; "*" = todos (cenário da demo).
# Na cota grátis o Google pode usar as mensagens. Vazio = só menus.
NUMEROS_IA=
# Retenção de métricas agregadas (sem texto, telefone ou endereço).
METRICAS_RETENCAO_DIAS=90

# --- API RevGás ---
# false = API falsa em memória (padrão). true = cria a venda na API de teste da RevGás (estabelecimento 2580).
# Limpar depois: npm run cancelar-venda -- <id>
VENDA_REAL=false
REVGAS_API_URL=https://api.revgas.com/v1
REVGAS_API_KEY=
REVGAS_CLIENTE_DEMO=
REVGAS_ESTABELECIMENTO=

# --- Painel "Pedido RevGás" (aba na conversa e "Pedidos de hoje" no menu do Chatwoot) ---
# Valor aleatório com 32+ caracteres. Vazio = painel desligado. Aplicado sozinho no docker compose up.
PAINEL_TOKEN=
# Endereços do Chatwoot que podem abrir o painel (separados por vírgula).
PAINEL_ORIGENS=http://localhost:3000,http://127.0.0.1:3000
# Endereço em que o navegador alcança o painel do bot. Vazio = http://127.0.0.1:3001 (a porta
# publicada no docker-compose.yml). Mude só se publicar o painel em outra porta ou endereço.
PAINEL_URL=
