# Copie para .env (que NUNCA vai para o git) e preencha.
# Para gerar valores aleatórios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Infra (Docker) ---
POSTGRES_PASSWORD=gere-um-valor-aleatorio
SECRET_KEY_BASE=gere-um-valor-aleatorio-com-64-caracteres
EVOLUTION_API_KEY=gere-um-valor-aleatorio

# --- Chatwoot ---
CHATWOOT_ACCOUNT_ID=1
# Token do SEU usuário admin (Chatwoot → Perfil → Token de acesso). Usado só pelo npm run setup.
CHATWOOT_ADMIN_TOKEN=
# Token do Agent Bot: o npm run setup imprime este valor.
CHATWOOT_BOT_TOKEN=
# Segredo no caminho do webhook do bot (16+ caracteres).
BOT_WEBHOOK_TOKEN=gere-um-valor-aleatorio

# --- IA (Gemini, cota grátis do Google AI Studio) ---
GEMINI_API_KEY=
# Modelo do Gemini (o Google aposenta modelos antigos; veja a lista em aistudio.google.com).
GEMINI_MODELO=gemini-3.1-flash-lite
# Só estes números (com 55 + DDD, separados por vírgula) usam a IA. Cota grátis pode usar os dados.
NUMEROS_IA=

# --- API RevGás ---
# false = API de teste em memória (padrão). true = cada pedido confirmado vira venda de verdade.
VENDA_REAL=false
REVGAS_API_URL=https://api.revgas.com/v1
REVGAS_API_KEY=
REVGAS_CLIENTE_DEMO=
REVGAS_ESTABELECIMENTO=

# --- Servidor (só no deploy, veja docs/deploy.md) ---
# DOMINIO=revgas-atende.duckdns.org
# FRONTEND_URL=https://revgas-atende.duckdns.org
